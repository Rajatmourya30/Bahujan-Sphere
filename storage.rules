rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for all files by default.
    // This is necessary for profile pictures and reading room PDFs to be viewed by anyone.
    match /{allPaths=**} {
      allow read;
    }

    // Securely allow an authenticated user to create, update, and delete
    // files ONLY within their own designated profile picture folder.
    match /profilePictures/{userId}/{allPaths=**} {
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users (admins) to upload PDFs.
    // In a real production app, you would lock this down further with custom claims.
    match /pdfs/{allPaths=**} {
        allow write: if request.auth != null;
    }
  }
}
