rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the user is a team member via Firestore.
    // exists() is more efficient and requires fewer permissions than get().
    function isTeamMember() {
      return request.auth != null && exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // --- SECURE RULES FOR PUBLIC AND TEAM CONTENT ---

    // This rule covers all nested paths within the specified public folders.
    // e.g., images/events/some-event/image.jpg will now be matched.
    match /{folder}/{allPaths=**} where folder in ['images', 'bookCovers', 'pdfs'] {
      // Anyone can read approved public content.
      allow read;
      
      // Only authenticated team members can write (upload, update, delete).
      // This resolves the unauthorized error for admins and other team members.
      allow write: if isTeamMember();
    }

    // --- SECURE RULES FOR USER-SPECIFIC CONTENT ---

    // Users can only read and write to their own profile picture directory.
    // This rule is specific and secure.
    match /profilePictures/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
