rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny all access to prevent accidental exposure
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public read access for images, covers, and PDFs.
    // Write access is restricted to authenticated users (team members/admins).
    match /images/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /bookCovers/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /pdfs/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // Users can only read and write to their own profile picture folder.
    match /profilePictures/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
