rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the user is a team member via Firestore.
    // exists() is more efficient and requires fewer permissions than get().
    function isTeamMember() {
      return exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // Publicly readable content folders, writable only by team members.
    // This allows admins to upload content while letting the public view it.
    match /{folder}/{fileName} where folder in ['images/events', 'images/logos', 'images/stores', 'bookCovers', 'pdfs'] {
      allow read; 
      allow write: if isTeamMember();
    }

    // User-specific folders, such as profile pictures.
    // A user can only read and write to their own folder.
    match /profilePictures/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
