
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Allow public read access for PDFs and cover images
    match /pdfs/{allPaths=**} {
      allow get: if true;
    }
     match /bookCovers/{allPaths=**} {
      allow get: if true;
    }

    // Allow public read access for profile pictures
     match /profilePictures/{userId}/{allPaths=**} {
      allow get: if true;
      allow write: if request.auth.uid == userId;
    }
    
    // Allow admins to write to any path
    match /{allPaths=**} {
      allow write: if isAdmin();
    }
  }
}
