rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the user is a team member.
    // exists() is more efficient and requires fewer permissions than get().
    function isTeamMember() {
      return exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // --- Rules for Public Content Folders ---
    // These folders store images and PDFs for the main application features.
    match /{folder}/{fileName} where folder in ['images/events', 'images/logos', 'images/stores', 'bookCovers', 'pdfs'] {
      
      // Allow public read access so any visitor can see approved content images/PDFs.
      allow read;
      
      // CRITICAL FIX: Only allow authenticated team members to write (upload/update/delete).
      // This is the main fix for the "storage/unauthorized" error for admins and other team roles.
      allow write: if isTeamMember();
    }

    // --- Rules for Profile Pictures ---
    // Users should only be able to manage their own profile pictures.
    match /profilePictures/{userId}/{fileName} {
      // Anyone can read profile pictures.
      allow read;
      
      // A user can only write to their own folder (`request.auth.uid == userId`).
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
