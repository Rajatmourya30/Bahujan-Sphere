rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // HELPER FUNCTION
    function isTeamMember() {
      // Check if user is authenticated and has team member custom claims
      return request.auth != null && 
             request.auth.token != null && 
             request.auth.token.teamMember == true;
    }

    // ALTERNATIVE HELPER FUNCTION - Check by querying teamMembers collection
    function isTeamMemberByEmail() {
      return request.auth != null && 
             request.auth.token != null && 
             request.auth.token.email != null &&
             exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // PUBLIC CONTENT & TEAM UPLOADS
    // Covers all paths where team members need to upload files.
    match /{allPaths=**} {
      // Allow public read access so visitors can see images and PDFs.
      allow read;
      
      // CRITICAL FIX: Allow authenticated team members to write (upload/delete).
      // Using custom claims approach for better performance and reliability.
      allow write: if isTeamMember() || isTeamMemberByEmail();
    }

    // USER-SPECIFIC FILES (Profile Pictures)
    // Users can only read and write to their own designated folder.
    match /profilePictures/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
