
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if the requesting user is an admin by checking the teamMembers collection in Firestore.
    function isAdmin() {
      return exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid)) ||
             exists(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role);
    }

    match /{allPaths=**} {
      // Allow read access to everyone for all files (e.g., public PDFs, cover images).
      allow read: if true;
      
      // Allow write access only to authenticated users who are admins.
      allow write: if request.auth != null && isAdmin();
    }
    
    // Specific rule to allow any authenticated user to upload their own profile picture.
    match /profilePictures/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
