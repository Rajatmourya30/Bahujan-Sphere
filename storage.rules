rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the authenticated user exists in the teamMembers collection in Firestore.
    // This is the secure way to grant write permissions.
    function isTeamMember() {
      return exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // --- Content Folders ---
    // Anyone can read content, but only verified team members can upload, update, or delete.
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isTeamMember();
    }

    match /bookCovers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isTeamMember();
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isTeamMember();
    }

    // --- Profile Pictures ---
    // Users can only read and write to their own profile picture folder.
    match /profilePictures/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
