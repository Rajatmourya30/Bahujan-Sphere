rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access for images, covers, and documents
    match /{folder}/{allPaths=**} where folder in ['images', 'bookCovers', 'pdfs'] {
      allow read: if true;
    }

    // Authenticated users can write to content folders
    match /{folder}/{allPaths=**} where folder in ['images', 'bookCovers', 'pdfs', 'profilePictures'] {
      allow write: if request.auth != null;
    }
  }
}
