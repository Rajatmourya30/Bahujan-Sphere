rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isTeamMember() {
      // exists() is more efficient and requires less permission than get()
      return request.auth != null && exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // Check if a corresponding user document exists in Firestore
    function userProfileExists(userId) {
      return exists(/databases/(default)/documents/users/$(userId));
    }

    // Public content folders
    match /{folder}/{fileName} where folder in ['images/events', 'images/logos', 'images/stores', 'bookCovers', 'pdfs'] {
      // Allow public read access so visitors can see images/PDFs.
      allow read; 
      
      // Only allow authenticated team members to write (upload/delete).
      allow write: if isTeamMember();
    }

    // Profile pictures: Users can only manage their own, and only if their profile document exists.
    match /profilePictures/{userId}/{fileName} {
      allow read; // Profile pictures are public
      allow write: if request.auth != null && request.auth.uid == userId && userProfileExists(userId);
    }
  }
}
