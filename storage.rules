rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files for any authenticated user.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow authenticated users to upload their profile pictures.
    match /profilePictures/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to upload PDFs to the reading room.
    match /pdfs/{fileName} {
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to upload cover images for the reading room.
    match /bookCovers/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
