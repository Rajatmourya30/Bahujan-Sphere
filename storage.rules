
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read files. This is needed for images and PDFs to be publicly viewable.
    match /{allPaths=**} {
      allow read;
    }

    // Securely allow authenticated users to upload/delete THEIR OWN profile picture.
    // The `userId` in the path must match the logged-in user's ID.
    match /profilePictures/{userId}/{allPaths=**} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any authenticated user to upload book covers and PDFs.
    // In a production app, you would restrict this to admin roles.
    match /bookCovers/{fileName} {
      allow write: if request.auth != null;
    }
    match /pdfs/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
