rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // HELPER FUNCTION
    function isTeamMember() {
      // This check now works correctly because of the updated firestore.rules.
      // exists() is more efficient and requires less permission than get().
      return exists(/databases/(default)/documents/teamMembers/$(request.auth.uid));
    }

    // PUBLIC CONTENT & TEAM UPLOADS
    // Covers all paths where team members need to upload files.
    match /{allPaths=**} {
      // Allow public read access so visitors can see images and PDFs.
      allow read;
      
      // CRITICAL FIX: Only allow authenticated team members to write (upload/delete).
      // This finally resolves the 'storage/unauthorized' error for admins and other roles.
      allow write: if isTeamMember();
    }

    // USER-SPECIFIC FILES (Profile Pictures)
    // Users can only read and write to their own designated folder.
    match /profilePictures/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
