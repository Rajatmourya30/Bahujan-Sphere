rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files for public viewing
    match /{allPaths=**} {
      allow read;
    }

    // Allow authenticated users to write to specific folders
    match /pdfs/{fileName} {
      allow write: if request.auth != null;
    }
    match /profile-pictures/{fileName} {
      allow write: if request.auth != null;
    }
    match /book-covers/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
