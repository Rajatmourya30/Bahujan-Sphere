
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Public Reading Room PDFs
    // Allow anyone to read, but only authenticated users to write.
    match /pdfs/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // User Profile Pictures
    // Allow users to read/write their own profile picture.
    // They can only access files within a folder that matches their UID.
    match /profilePictures/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

    