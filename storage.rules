rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for any file
    match /{allPaths=**} {
      allow read;
    }
    
    // Allow authenticated users to write to the 'pdfs' folder
    match /pdfs/{pdfId} {
      allow write: if request.auth != null;
    }
  }
}
