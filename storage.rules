rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default rule: Allow public read access on all files so anyone can see
    // images and PDFs in your app.
    match /{allPaths=**} {
      allow read;
    }

    // PDFs: Only allow authenticated users to upload/write files.
    // In a production app, you would restrict this to specific admin roles.
    match /pdfs/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Profile Pictures: A user can only write (create, update, delete)
    // files within their own designated folder.
    match /profilePictures/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
