rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to get the user's role from Firestore.
    // Assumes a 'teamMembers' collection where the document ID is the user's UID.
    function getRole() {
      return get(/databases/(default)/documents/teamMembers/$(request.auth.uid)).data.role;
    }

    // --- READ ACCESS (Secure) ---
    // CRITICAL FIX: Restrict read access based on content approval status
    // This is a fallback rule - specific folder rules below take precedence
    match /{allPaths=**} {
      allow read: if false; // Deny by default, specific rules below handle access
    }

    // --- WRITE ACCESS (Specific Folders) ---

    // 1. Profile Pictures: Allow authenticated users to upload their *own* profile picture.
    // The folder path MUST be their UID.
    match /profilePictures/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Content Uploads (PDFs, Covers, Logos, etc.):
    // Allow users with a role in the teamMembers collection to write to these folders.
    function isTeamMember() {
      return getRole() in ['Admin', 'Manager', 'Editor', 'Reviewer', 'Contributor'];
    }

    match /pdfs/{fileName} {
      allow read: if request.auth != null && isTeamMember();
      allow write: if request.auth != null && isTeamMember();
    }
    match /bookCovers/{fileName} {
      allow read: if request.auth != null && isTeamMember();
      allow write: if request.auth != null && isTeamMember();
    }
    match /images/books/{fileName} {
      allow read: if request.auth != null && isTeamMember();
      allow write: if request.auth != null && isTeamMember();
    }
    match /images/logos/{fileName} {
      allow read: if request.auth != null && isTeamMember();
      allow write: if request.auth != null && isTeamMember();
    }
    match /images/stores/{fileName} {
      allow read: if request.auth != null && isTeamMember();
      allow write: if request.auth != null && isTeamMember();
    }
  }
}
