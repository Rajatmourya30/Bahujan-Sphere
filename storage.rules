rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Allow public read access to final PDF and cover image folders
    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Allow any authenticated user to write
    }

    match /bookCovers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to write to profile pictures
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other routes
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
