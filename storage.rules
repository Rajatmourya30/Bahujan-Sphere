rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.role != null && 
             request.auth.token.role in ['Admin', 'Manager'];
    }

    // TEMPORARY: Allow all authenticated users full access for testing
    // TODO: Revert to admin-only access once token refresh is working
    match /{allPaths=**} {
      allow list, read, write, delete: if request.auth != null;
    }

    // Admin access - allow admins to list, read, write, and delete all files
    // match /{allPaths=**} {
    //   allow list, read, write, delete: if isAdmin();
    // }

    // TEMPORARY FIX: Allow all authenticated users to upload to events
    // This bypasses the team member check temporarily
    match /images/events/{fileName} {
      allow read;
      allow write: if request.auth != null; // Any authenticated user can upload
    }
    
    // TEMPORARY FIX: Allow all authenticated users to upload to other folders
    match /images/logos/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /images/stores/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /bookCovers/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /pdfs/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    // QR codes for payment methods - allow authenticated users to upload
    match /qr-codes/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }

    // Profile pictures - keep original rules
    match /profilePictures/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
