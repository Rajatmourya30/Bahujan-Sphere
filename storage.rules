rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default to denying all access unless explicitly allowed
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow public read access for essential image and content folders
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // Allow writes for authenticated users
    }

    match /bookCovers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users can read all profile pictures, but can only write to their own directory
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
