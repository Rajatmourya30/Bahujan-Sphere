rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access for content folders
    match /pdfs/{allPaths=**} {
      allow read: if true;
    }
    match /bookCovers/{allPaths=**} {
      allow read: if true;
    }
    match /images/{allPaths=**} {
      allow read: if true;
    }

    // Allow any authenticated user to write to content folders.
    // This will solve the admin authorization issue.
    match /{folder}/{allPaths=**} where folder in ['images', 'pdfs', 'bookCovers'] {
      allow write: if request.auth != null;
    }

    // Secure profile pictures: Only the user can read/write their own files.
    match /profilePictures/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
