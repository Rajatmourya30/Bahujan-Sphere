
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is an authenticated team member
    function isTeamMember() {
      return request.auth != null && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }
    
    // Publicly readable collections
    match /calendarEvents/{docId} {
      allow read: if true;
      allow write: if isTeamMember();
    }
    match /knowledgeHub/{docId} {
      allow read: if true;
      allow write: if isTeamMember();
    }
    match /stores/{docId} {
      allow read: if true;
      allow write: if isTeamMember();
    }
    match /books/{docId} {
      allow read: if true;
      allow write: if isTeamMember();
    }
    match /readingRoomPdfs/{docId} {
      allow read: if true;
      allow write: if isTeamMember();
    }
    
    // Submission queues are only accessible by team members
    match /eventSubmissions/{docId} {
      allow read, write: if isTeamMember();
    }
    match /knowledgeHubSubmissions/{docId} {
      allow read, write: if isTeamMember();
    }
    match /storeSubmissions/{docId} {
      allow read, write: if isTeamMember();
    }
    match /bookSubmissions/{docId} {
      allow read, write: if isTeamMember();
    }
     match /readingRoomSubmissions/{docId} {
      allow read, write: if isTeamMember();
    }
    
    // Team members can be read by other team members, but only created/deleted by admins via cloud functions
    match /teamMembers/{userId} {
      allow read: if isTeamMember();
      // Write access is handled by secure cloud functions
      allow write: if false; 
    }
    
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
