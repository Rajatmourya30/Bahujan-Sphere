rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow any authenticated user to list the collection of users.
      allow list: if request.auth != null;
      // Allow a user to read, create, update, or delete their own document.
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /teamMembers/{memberId} {
      // Only authenticated users can read the team list.
      // In a real app, you might restrict this further to only other team members.
      allow read: if request.auth != null;
      // For create, update, delete, you would add more restrictive rules,
      // e.g., only allow users with an "Admin" role claim.
      // For now, we will allow any authenticated user to manage the list for simplicity.
      allow create, update, delete: if request.auth != null;
    }
    match /readingRoomPdfs/{pdfId} {
      // Anyone can read the list of PDFs.
      allow get, list: if true;
      // Only authenticated users (admins) can upload/delete PDFs.
      allow create, delete: if request.auth != null;
    }
  }
}
