rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Publicly readable collections
    match /calendarEvents/{eventId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager', 'Editor'];
    }
    match /knowledgeHub/{orgId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager'];
    }
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager'];
    }
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager'];
    }
    match /readingRoomPdfs/{pdfId} {
        allow read: if true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager'];
    }

    // User profiles: Only the owner can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Team members: Only admins can manage the team list
    match /teamMembers/{memberId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager'];
        allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role == 'Admin';
    }

    // Submission collections: Any authenticated team member can create, but only admins/managers can review/delete
    match /eventSubmissions/{submissionId} {
        allow create: if request.auth != null; // Team members can submit
        allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager', 'Editor', 'Reviewer'];
    }
     match /bookSubmissions/{submissionId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager', 'Editor', 'Reviewer'];
    }
     match /knowledgeHubSubmissions/{submissionId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager', 'Editor', 'Reviewer'];
    }
     match /storeSubmissions/{submissionId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager', 'Editor', 'Reviewer'];
    }
     match /readingRoomSubmissions/{submissionId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role in ['Admin', 'Manager', 'Editor', 'Reviewer'];
    }
  }
}