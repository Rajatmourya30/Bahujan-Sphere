rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows a user to read and write to their own document in the 'users' collection.
    // This is essential for signup and profile management.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // This rule allows any authenticated user (including admins signed in anonymously)
    // to create documents in the 'readingRoomPdfs' collection, and allows anyone to read them.
    match /readingRoomPdfs/{docId} {
      allow read;
      allow create: if request.auth != null;
    }
  }
}
