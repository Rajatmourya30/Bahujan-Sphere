rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember() {
      // Securely checks if a user's UID exists in the teamMembers collection.
      // This is the primary function for checking admin/editor/etc. privileges.
      return isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isApproved(resource) {
      // Checks if a document has the 'approved' status.
      return resource.data.status == 'approved';
    }

    // TEAM MEMBERS & USERS
    match /teamMembers/{userId} {
      // IMPORTANT FIX: Allow any authenticated user to check for the EXISTENCE of their own team member document.
      // This is required for Storage rules to function correctly. This rule does NOT allow reading the document's data.
      allow get: if isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid)) || isOwner(userId);
      allow list: if isTeamMember();
      allow write: if isTeamMember(); // Allow admins to manage team members
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create; // Allow new user signups
    }

    // PUBLIC CONTENT COLLECTIONS
    // Users can only read approved content. Team members can write and read all content.
    match /{collectionName}/{docId} where collectionName in ['calendarEvents', 'knowledgeHub', 'stores', 'books', 'readingRoomPdfs'] {
      allow read: if isApproved(resource) || isTeamMember();
      allow write: if isTeamMember();
    }
    
    // SUBMISSION COLLECTIONS
    // Only team members can manage submissions.
    match /{submissionCollection}/{submissionId} where submissionCollection in ['eventSubmissions', 'bookSubmissions', 'storeSubmissions', 'knowledgeHubSubmissions', 'readingRoomSubmissions'] {
      allow create, read, update, delete: if isTeamMember();
    }
  }
}
