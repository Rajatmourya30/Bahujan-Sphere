rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if the user's email exists in the teamMembers collection.
    function isAdmin() {
      return exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    // Publicly readable collections
    match /readingRoomPdfs/{docId} {
      allow read: if true;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // All other collections are admin-only
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }
  }
}
