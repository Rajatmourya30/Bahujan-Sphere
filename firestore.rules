rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember() {
      // Securely checks if a user's UID exists in the teamMembers collection
      return isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    function isApprovedContent(resource) {
      // Checks the status field of a document
      return resource.data.status == 'approved';
    }

    // PUBLIC CONTENT: Only approved content is publicly readable
    match /calendarEvents/{docId} {
      allow read: if isApprovedContent(resource) || isTeamMember();
      allow write: if isTeamMember();
    }
    
    match /knowledgeHub/{docId} {
      allow read: if isApprovedContent(resource) || isTeamMember();
      allow write: if isTeamMember();
    }
    
    match /stores/{docId} {
      allow read: if isApprovedContent(resource) || isTeamMember();
      allow write: if isTeamMember();
    }
    
    match /books/{docId} {
      allow read: if isApprovedContent(resource) || isTeamMember();
      allow write: if isTeamMember();
    }
    
    match /readingRoomPdfs/{docId} {
      allow read: if isApprovedContent(resource) || isTeamMember();
      allow write: if isTeamMember();
    }

    // SUBMISSIONS: Only accessible by team members
    match /eventSubmissions/{submissionId} {
      allow create, read, update, delete: if isTeamMember();
    }
    
    match /bookSubmissions/{submissionId} {
      allow create, read, update, delete: if isTeamMember();
    }
    
    match /storeSubmissions/{submissionId} {
      allow create, read, update, delete: if isTeamMember();
    }
    
    match /knowledgeHubSubmissions/{submissionId} {
      allow create, read, update, delete: if isTeamMember();
    }
    
    match /readingRoomSubmissions/{submissionId} {
      allow create, read, update, delete: if isTeamMember();
    }
    
    // TEAM MEMBERS: Secure access to team info
    match /teamMembers/{memberId} {
      allow read: if isTeamMember(); // Team members can see other team members
      allow write: if false; // Should be handled by secure Cloud Functions
    }

    // USER PROFILES: Publicly readable, but only the owner can write.
    match /users/{userId} {
      allow read: if true; // Public profiles are readable by anyone
      allow create: if isSignedIn() && request.auth.uid == userId; // A user can create their own profile document
      allow update: if isSignedIn() && request.auth.uid == userId; // A user can update their own profile
      allow delete: if isSignedIn() && request.auth.uid == userId; // A user can delete their own profile
    }
  }
}
