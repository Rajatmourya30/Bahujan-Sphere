rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow public read access to specific collections needed by the app
    match /readingRoomPdfs/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Allow any authenticated user to write
    }
    
    match /events/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow any authenticated user (i.e., your logged-in team members)
    // to read and write to all other collections like submissions, users, etc.
    match /{collection}/{docId} {
       allow read, write: if request.auth != null;
    }
  }
}
