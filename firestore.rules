rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions for security rules.
    // These functions can be reused across different rules.

    // Checks if the user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the authenticated user is a documented team member.
    // This is more secure than checking a custom claim alone as it requires a Firestore document.
    function isTeamMember() {
      return isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }
    
    // Checks if a document has been approved for public viewing.
    function isApprovedContent(resource) {
      return resource.data.status == 'approved';
    }

    // --- Rules for Publicly Viewable Content ---
    // These collections contain content that, once approved, can be read by anyone.
    match /{collectionName}/{docId} where collectionName in ['calendarEvents', 'knowledgeHub', 'stores', 'books', 'readingRoomPdfs'] {
      // Public can ONLY read documents where status is 'approved'. This prevents data leaks.
      allow read: if isApprovedContent(resource);
      // Team members can read all documents, including pending ones for review.
      allow read: if isTeamMember();
      
      // Only team members can create, update, or delete content.
      allow write: if isTeamMember();
    }

    // --- Rules for User Profiles ---
    // The 'users' collection stores public user profile data.
    match /users/{userId} {
        // Any user can read any public profile.
        allow read: if true;
        // An authenticated user can create their own profile document.
        allow create: if isSignedIn() && request.auth.uid == userId;
        // A user can only update their own profile.
        allow update: if isSignedIn() && request.auth.uid == userId;
        // A user can delete their own profile.
        allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    // --- Rules for Submission Queues ---
    // These collections hold content pending review by team members.
    match /{submissionCollection}/{submissionId} where submissionCollection in ['eventSubmissions', 'bookSubmissions', 'storeSubmissions', 'knowledgeHubSubmissions', 'readingRoomSubmissions'] {
      // Only team members can access the submission queues.
      allow read, write: if isTeamMember();
    }
    
    // --- Rules for Team Management ---
    // The 'teamMembers' collection is sensitive and access is restricted.
    match /teamMembers/{memberId} {
      // Allow a user's role to be read by other rules (e.g., in Storage rules).
      allow get: if isSignedIn();
      // Only team members can see the list of other team members.
      allow list: if isTeamMember();
      // Writing/deleting members should be handled by a secure Cloud Function, not directly by clients.
      allow write: if isTeamMember();
    }
  }
}
