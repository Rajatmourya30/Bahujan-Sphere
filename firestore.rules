rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if a user's email exists in the teamMembers collection
    function isAdmin() {
      return exists(/databases/$(database)/documents/teamMembers) &&
             get(/databases/$(database)/documents/teamMembers).data.values().hasAny(['email'], request.auth.token.email);
    }

    // Logged-in users can read their own user document
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Public read for events, books, etc.
    match /readingRoomPdfs/{docId} {
      allow read: if true;
    }

    // Admins can read and write to any other document
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
