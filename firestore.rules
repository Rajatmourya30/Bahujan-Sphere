
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is an admin by seeing if their email exists in the teamMembers collection.
    function isAdmin() {
      return exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid)) ||
             exists(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role);
    }
    
    // Allow admins full access
    match /{document=**} {
      allow read, write: if request.auth != null && isAdmin();
    }

    // Allow logged-in users to read their own profile
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Public read access for specific collections
    match /readingRoomPdfs/{docId} {
      allow get: if true;
    }
  }
}
