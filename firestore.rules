rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember() {
      // Check if a user is in the teamMembers collection
      return isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    function isApprovedContent(resource) {
      // Check if the document has a status of 'approved'
      return resource.data.status == 'approved';
    }

    // Public content collections: Only approved content is publicly readable
    match /{collectionName}/{docId} where collectionName in ['calendarEvents', 'knowledgeHub', 'stores', 'books', 'readingRoomPdfs'] {
      // Public users can ONLY read approved content.
      allow read: if isApprovedContent(resource);
      
      // Team members can read ALL content (pending, approved, etc.)
      allow read: if isTeamMember();

      // Only team members can write/modify content.
      allow write: if isTeamMember();
    }

    // User profiles: Users can manage their own profile
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if isSignedIn();
    }

    // Submissions collections: Only team members can access
    match /{submissionCollection}/{submissionId} where submissionCollection in ['eventSubmissions', 'bookSubmissions', 'storeSubmissions', 'knowledgeHubSubmissions', 'readingRoomSubmissions'] {
      allow create, read, update, delete: if isTeamMember();
    }
    
    // Team management: Secure access
    match /teamMembers/{memberId} {
      // A user can read their own team member document
      allow read: if isSignedIn() && request.auth.uid == memberId;
      // A team member can read other team members' documents
      allow read: if isTeamMember();
      // Writing to teamMembers is restricted (e.g., only via Cloud Functions)
      allow write: if false;
    }
  }
}
