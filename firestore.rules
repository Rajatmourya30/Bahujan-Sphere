
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember() {
      // Check if a user document exists in the 'teamMembers' collection with the user's UID.
      // This is a simple and effective way to check for team membership without reading document data.
      return isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }
    
    // Public Content Rules (e.g., calendar, knowledge hub, etc.)
    // These collections should be publicly readable but only writable by team members.
    match /{publicCollection}/{docId} 
        where publicCollection in ['calendarEvents', 'knowledgeHub', 'stores', 'books', 'readingRoomPdfs'] {
      allow read: if true;
      allow write: if isTeamMember();
    }

    // User Profile Rules
    // Users can create their own profile and can only read/update their own.
    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn();
    }

    // Submission Rules (for content pending approval)
    // Any team member can create, read, and manage submissions.
    match /{submissionCollection}/{submissionId} 
        where submissionCollection in ['eventSubmissions', 'bookSubmissions', 'storeSubmissions', 'knowledgeHubSubmissions', 'readingRoomSubmissions'] {
      allow create, read, update, delete: if isTeamMember();
    }
    
    // Team Management Rules
    match /teamMembers/{memberId} {
      // Allow authenticated users to read their own team member document. This is needed for role checks.
      allow read: if isSignedIn() && request.auth.uid == memberId;
      // Allow existing team members to read other team members' documents (e.g., for an admin panel).
      allow read: if isTeamMember();

      // IMPORTANT: Block all direct writes to the teamMembers collection.
      // Team management (adding, removing, changing roles) should ONLY be handled
      // by a secure backend environment, like a Firebase Cloud Function.
      allow write: if false; 
    }
  }
}
