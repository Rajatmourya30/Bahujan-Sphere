rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to most collections
    match /{document=**} {
      allow read: if true;
    }
    
    // Secure the users collection
    match /users/{userId} {
      // Allow users to read and write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins could be given broader access if needed, but this is a secure default
    }

    // Allow authenticated users (like our anonymous admin uploader) to write to readingRoomPdfs
    match /readingRoomPdfs/{docId} {
       allow read: if true;
       allow create, write, delete: if request.auth != null;
    }
  }
}
