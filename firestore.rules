rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the signed-in user is a team member.
    // This is a simple existence check and avoids circular dependencies.
    function isTeamMember() {
      return isSignedIn() && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    // Helper function to check if public content has been approved.
    function isApprovedContent(resource) {
      return resource.data.status == 'approved';
    }

    // PUBLIC CONTENT:
    // - Public users can only read documents with status 'approved'.
    // - Team members can read all documents (pending, approved, etc.).
    // - Only team members can write/edit.
    match /{collectionName}/{docId} where collectionName in ['calendarEvents', 'knowledgeHub', 'stores', 'books', 'readingRoomPdfs'] {
      allow read: if isApprovedContent(resource) || isTeamMember();
      allow write: if isTeamMember();
    }

    // USER PROFILES:
    // Users can create, read, and update their own profile.
    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn();
    }

    // SUBMISSIONS:
    // Any team member can create, read, update, and delete submissions.
    // Role-specific logic (e.g., only an Admin can approve) should be handled
    // in the application code or Firebase Functions.
    match /{submissionCollection}/{submissionId} where submissionCollection in ['eventSubmissions', 'bookSubmissions', 'storeSubmissions', 'knowledgeHubSubmissions', 'readingRoomSubmissions'] {
      allow create, read, update, delete: if isTeamMember();
    }
    
    // TEAM MANAGEMENT:
    // - Team members can read other team members' documents.
    // - Any signed-in user can read their own document (necessary for isTeamMember() to work).
    // - IMPORTANT: No one can write directly to this collection. Team members should be added/managed
    //   via a secure Firebase Function to prevent unauthorized privilege escalation.
    match /teamMembers/{memberId} {
      allow read: if isTeamMember() || (isSignedIn() && request.auth.uid == memberId);
      allow write: if false; // Prevent direct client-side writes. Use Firebase Functions.
    }
  }
}
