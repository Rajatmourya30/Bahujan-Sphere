rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // TEMPORARY FIX: Allow all authenticated users to upload to events
    // This bypasses the team member check temporarily
    match /images/events/{fileName} {
      allow read;
      allow write: if request.auth != null; // Any authenticated user can upload
    }
    
    // TEMPORARY FIX: Allow all authenticated users to upload to other folders
    match /images/logos/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /images/stores/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /bookCovers/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }
    
    match /pdfs/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }

    // Profile pictures - keep original rules
    match /profilePictures/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
